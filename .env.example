# ---------------------------------------------------------------
# Blue Market Ads — environment variables
# Copy into Vercel: Project > Settings > Environment Variables.
# Nothing here is required for a first look: with no Google Ads
# credentials the app runs in demo mode with sample accounts.
# ---------------------------------------------------------------

# Signs login sessions. Any long random string (e.g. `openssl rand -base64 32`).
AUTH_SECRET=

# Team logins (JSON on one line). Create each hash with:
#   npm run hash-password -- "the password"
# Required once Google Ads is connected; until then a demo login works.
TEAM_USERS=[{"email":"robert@bluemarketads.com","name":"Robert","passwordHash":"$2b$12$..."}]

# Google Ads API (from your manager account + Google Cloud OAuth client)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v25
# true = Google checks every change but applies nothing (safe testing).
ADS_VALIDATE_ONLY=true

# The agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# n8n (base URL of your webhooks, and a shared secret)
N8N_WEBHOOK_BASE=https://your-n8n.example.com/webhook
N8N_WEBHOOK_SECRET=

# Storage for account strategy profiles + change history.
# Add the Upstash Redis integration in Vercel's Marketplace and these fill in.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
